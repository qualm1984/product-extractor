{
  "manifest_version": 3,
  "name": "Product Grid Extractor",
  "version": "1.0",
  "description": "Extracts product information from grid layouts",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["content_scripts/extractor.js"],
    "matches": ["<all_urls>"]
  }]
} 