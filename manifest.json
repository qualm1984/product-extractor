{
  "manifest_version": 3,
  "name": "Product Grid Extractor",
  "version": "1.0",
  "description": "Extracts product information from grid layouts",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.google.com/*"
  ],
  "action": {},
  "content_scripts": [
    {
      "matches": ["*://*.google.com/*"],
      "js": ["content_scripts/extractor.js"]
    }
  ]
} 